# Copy this file to .env and fill in the values
# Add up to 3 Gemini API keys — requests round-robin across all configured keys
GEMINI_API_KEY_1=AIza...
GEMINI_API_KEY_2=AIza...
GEMINI_API_KEY_3=AIza...

# Optional: shared bearer token the extension sends for auth
PROXY_TOKEN=choose-a-long-random-string

PORT=3001
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
