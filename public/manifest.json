{
  "manifest_version": 3,
  "name": "Reg Library Source Finder",
  "version": "1.0.0",
  "description": "Discover and track new regulatory sources for your compliance library",
  "permissions": ["storage", "alarms", "activeTab", "scripting", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Reg Library Source Finder"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
