{
  "manifest_version": 3,
  "name": "Vixio Reg Library Finder",
  "version": "1.0.0",
  "description": "Scan the web for new regulatory documents not yet in your compliance library",
  "permissions": ["storage", "alarms", "activeTab", "scripting", "downloads", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Reg Library Scanner"
  },
  "side_panel": {
    "default_path": "src/reporting/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
