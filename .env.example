# Copy to .env.local — Vite reads this at build/dev time
# Dev: leave as localhost. Production: set to your deployed proxy URL.
VITE_PROXY_URL=http://localhost:3001
VITE_PROXY_TOKEN=choose-a-long-random-string

# Optional: call Gemini directly from the client (NOT recommended for production,
# because the key is bundled into the extension build)
VITE_GEMINI_API_KEY=AIza...

# Optional: override model (default: gemini-2.5-flash)
VITE_GEMINI_MODEL=gemini-2.5-flash
